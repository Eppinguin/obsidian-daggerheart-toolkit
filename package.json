{
    "name": "daggerheart-toolkit",
    "version": "0.0.3",
    "description": "Obsidian plugin for Daggerheart GMs, adversary statblocks, environments, and encounters",
    "keywords": [],
    "license": "MIT",
    "author": "",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "lint": "oxlint .",
        "fmt": "oxfmt .",
        "fmt:check": "oxfmt --check .",
        "test:compendium": "node scripts/test-compendium-path.mjs",
        "test:sources": "node scripts/test-content-source-migration.mjs",
        "test:store": "node scripts/test-statblock-store.mjs",
        "test:licensed": "node scripts/test-licensed-content.mjs",
        "test:markdown": "node scripts/test-markdown-statblock.mjs",
        "test:scaler": "node scripts/test-adversary-scaler.mjs",
        "test:thresholds": "node scripts/test-encounter-thresholds.mjs",
        "test:drag-order": "node scripts/test-encounter-drag-order.mjs",
        "test:rename": "node scripts/test-instance-rename.mjs",
        "test:scaler-dismiss": "node scripts/test-tier-scaler-dismiss.mjs",
        "test:compendium-entry": "node scripts/test-compendium-entry.mjs",
        "test:statblock-format": "node scripts/test-statblock-format.mjs",
        "test:statblock-import": "node scripts/test-statblock-import-integration.mjs",
        "test:encounter-import": "node scripts/test-encounter-import.mjs",
        "test:summon": "node scripts/test-summon.mjs",
        "test:feature-type": "node scripts/test-feature-type.mjs",
        "test:role-family": "node scripts/test-role-family.mjs",
        "test:countdown-loop": "node scripts/test-countdown-loop.mjs",
        "test:wheel-scroll": "node scripts/test-wheel-scroll.mjs",
        "test:card-density": "node scripts/test-card-density.mjs",
        "test:instance-blocks": "node scripts/test-instance-blocks.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "release:plugin": "node scripts/release.mjs plugin",
        "release:extension": "node scripts/release.mjs extension"
    },
    "dependencies": {
        "dddice-js": "0.19.34-974",
        "js-yaml": "^4.1.0",
        "uuid": "^10.0.0"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^16.11.7",
        "@types/uuid": "^10.0.0",
        "esbuild": "^0.17.17",
        "obsidian": "latest",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "tslib": "^2.8.1",
        "typescript": "^5.0.4"
    }
}
