{
    "name": "daggerheart-toolkit",
    "version": "0.0.1",
    "description": "Obsidian plugin for Daggerheart Adversary statblocks and Character Sheets",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "release": "pnpm run build && git add . && git commit -m \"Release $npm_package_version\" && git tag $npm_package_version && git push && git push --tags"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^16.11.7",
        "@types/uuid": "^10.0.0",
        "esbuild": "^0.17.17",
        "obsidian": "latest",
        "tslib": "^2.8.1",
        "typescript": "^5.0.4"
    },
    "dependencies": {
        "dddice-js": "0.19.34-974",
        "js-yaml": "^4.1.0",
        "uuid": "^10.0.0"
    }
}
