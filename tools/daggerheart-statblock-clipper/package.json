{
    "name": "daggerheart-statblock-clipper",
    "version": "0.1.0",
    "private": true,
    "description": "Cross-browser Daggerheart statblock importer for Obsidian.",
    "type": "module",
    "scripts": {
        "dev": "vite --mode chromium",
        "build": "npm run build:chromium && npm run build:firefox",
        "build:chromium": "node scripts/build.mjs chromium",
        "build:firefox": "node scripts/build.mjs firefox",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "test:browser": "node tests/browser/integration.mjs",
        "validate": "node scripts/validate-build.mjs",
        "lint:firefox": "web-ext lint --source-dir dist/firefox",
        "package": "npm run package:chromium && npm run package:firefox",
        "package:chromium": "web-ext build --source-dir dist/chromium --artifacts-dir artifacts --filename daggerheart-statblock-clipper-chromium.zip --overwrite-dest",
        "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir artifacts --filename daggerheart-statblock-clipper-firefox.xpi --overwrite-dest",
        "ci": "npm test && npm run build && npm run validate && npm run test:browser && npm run lint:firefox && npm run package"
    },
    "devDependencies": {
        "@types/chrome": "^0.2.5",
        "playwright": "^1.62.1",
        "selfsigned": "5.5.0",
        "typescript": "^7.0.2",
        "vite": "8.2.0",
        "vitest": "^4.1.10",
        "web-ext": "10.6.0"
    },
    "engines": {
        "node": ">=22.13"
    },
    "packageManager": "pnpm@11.20.0"
}
