{
    "compilerOptions": {
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES2020",
        "allowJs": true,
        "noEmit": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "importHelpers": true,
        "isolatedModules": true,
        "strictNullChecks": true,
        "lib": ["DOM", "ES2020"]
    },
    "include": ["**/*.ts"],
    // The browser extension is a separate TypeScript project with its own
    // stricter tsconfig; `pnpm --dir tools/daggerheart-statblock-clipper run
    // typecheck` covers it.
    "exclude": ["node_modules", "tools/daggerheart-statblock-clipper"]
}
